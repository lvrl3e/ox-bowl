# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# --- Supabase ----------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used for order creation, screenshot uploads, and admin signed URLs.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Site ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://oxbowl.example.com

# --- Telegram owner notifications (Step 6) --------------------------------
# Create a bot with @BotFather, then message it and call
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=

# --- Analytics / Pixel placeholders (Step 8) ------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
